# PostgreSQL — REQUIRED; no default in code (prevents accidental plaintext passwords).
# Replace <password> with your actual password.
# In Docker, DATABASE_URL is injected via docker-compose.yml using the service name "postgres"
DATABASE_URL=postgresql://glokta:<password>@localhost:5432/glokta

# OpenRouter — required, no default
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# garak tuning — adjust to match your OpenRouter plan tier
# Free tier is typically ~60 RPM; paid plans allow more
OPENROUTER_RPM_LIMIT=60
GARAK_PARALLEL_ATTEMPTS=10
GARAK_SOFT_PROBE_PROMPT_CAP=50

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Gradio — for local dev use localhost; in Docker use the API container service name "api"
GRADIO_SERVER_PORT=7860
API_BASE_URL=http://localhost:8000

# HuggingFace Dataset sync — optional, only needed for export/import scripts
# HF_DATASET_REPO=JakeBx/glokta
# HF_TOKEN=hf_your_token_here

# CTI living benchmark — optional; CTI_ENABLED gates the CTI ingest/eval flows
# CTI_ENABLED=false
# NVD_API_KEY=your-nvd-api-key            # 50 req/30s with key, 5/30s without
# CTI_DATA_DIR=/tmp/glokta-cti            # git clone path for cvelistV5/galaxy/attack
# CTI_RPM_LIMIT=600
# CTI_PREQUENTIAL_FADING_FACTOR=0.99
# CTI_WITHHOLD_WINDOW_DAYS=14
# CTI_JUDGE_MODEL=claude-opus-4-8
# Recent-slice bounding + eval safety rails
# CTI_INGEST_LOOKBACK_DAYS=3      # only ingest items changed within this window
# CTI_MAX_ITEMS_PER_RUN=100       # hard cap on inference calls per CTI run
# CTI_EVAL_COMMIT_EVERY=20        # commit results every N items (enables resume)
# CTI_RUN_TIMEOUT_SECONDS=3600    # wall-clock budget per CTI run
