# Copy this file to docker/.env and fill in real values
# Usage: docker compose --env-file docker/.env -f docker/docker-compose.yml up

# Required
OPENROUTER_API_KEY=sk-or-v1-your-key-here
POSTGRES_PASSWORD=changeme-use-a-strong-password

# Optional overrides (defaults shown)
OPENROUTER_RPM_LIMIT=60
GARAK_PARALLEL_ATTEMPTS=10
GARAK_SOFT_PROBE_PROMPT_CAP=50

# CTI living benchmark — MUST be true for the worker to run any CTI flow (incl. cti-scan-pending)
CTI_ENABLED=false
# HF_TOKEN is needed for HF-hosted models under test; the judge uses OPENROUTER_API_KEY above
HF_TOKEN=
CTI_JUDGE_MODEL=anthropic/claude-opus-4.8
CTI_INGEST_LOOKBACK_DAYS=3
CTI_REPORT_SOURCES=cisa,cccs,ncsc,dfir
CTI_REPORT_MAX_PER_SOURCE=20
CTI_WITHHOLD_WINDOW_DAYS=14
CTI_MAX_ITEMS_PER_RUN=100
